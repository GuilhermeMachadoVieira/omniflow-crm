# Banco de dados (PostgreSQL)
# Supabase / outro host: use a URL de conexão e codifique caracteres especiais na senha (ex: @ → %40)
# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/omniflow_crm
DIRECT_URL=postgresql://postgres:password@localhost:5432/omniflow_crm

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sentry (monitoramento de erros)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Analytics/Web Vitals
NEXT_PUBLIC_ENABLE_WEB_VITALS=false

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-here

# Auth (legado)
# Se você ainda estiver usando o sistema antigo de cookie assinado, use AUTH_SECRET.
# Com NextAuth, o segredo obrigatório é NEXTAUTH_SECRET.
AUTH_SECRET=your-super-secret-key-here

# Cookie
# Opcional: use seu domínio raiz para compartilhar cookie entre subdomínios.
# Ex: .seu-dominio.com (inclua o ponto inicial)
AUTH_COOKIE_DOMAIN=

# Production (Vercel)
# DATABASE_URL=postgresql://postgres:password@your-db-host:5432/your-db
# DIRECT_URL=postgresql://postgres:password@your-db-host:5432/your-db
# NEXTAUTH_URL=https://your-app.vercel.app
# NEXTAUTH_SECRET=your-production-secret-key
# AUTH_SECRET=your-production-auth-secret-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
