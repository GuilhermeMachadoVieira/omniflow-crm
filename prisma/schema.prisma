// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------
// CRM SaaS - Multi-tenant Models
// -----------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?  // Logo em Base64
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  customers        Customer[]
  pipelineColumns  PipelineColumn[]
  opportunities    Opportunity[]
  activities       Activity[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  nome           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           Role     @default(MEMBER)
  image          String?  // Avatar em Base64
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    Customer[]
  activities   Activity[]

  @@map("users")
}

model Customer {
  id               String         @id @default(uuid())
  nome             String
  email            String
  telefone         String?
  empresa          String?
  document         String?        // CPF/CNPJ
  address          String?        // Endereço completo
  source           String?        // Origem: Google, Indicação, Instagram, etc
  tags             String[]       // Array de strings para segmentação
  notes            String?        // Observações gerais
  status           CustomerStatus @default(ACTIVE)
  lastPurchaseDate DateTime?      @map("last_purchase_date")
  totalRevenue     Decimal        @default(0) @map("total_revenue") @db.Decimal(12, 2)
  userId           String         @map("user_id")
  organizationId   String         @map("organization_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@map("customers")
}

model PipelineColumn {
  id             String   @id @default(uuid())
  title          String
  sortOrder      Int      @map("sort_order")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@map("pipeline_columns")
}

model Opportunity {
  id                String    @id @default(uuid())
  title             String
  value             Decimal   @db.Decimal(12, 2)
  priority          Priority  @default(MEDIUM)
  probability       Int       @default(50)        // 0 a 100%
  expectedCloseDate  DateTime? @map("expected_close_date")
  columnId          String    @map("column_id")
  organizationId    String    @map("organization_id")
  createdAt         DateTime   @default(now()) @map("created_at")

  column       PipelineColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("opportunities")
}

model Activity {
  id             String   @id @default(uuid())
  type           String   // "NOTE", "CALL", "EMAIL", "MEETING"
  content        String   // O texto da anotação
  createdAt      DateTime @default(now())
  organizationId String   @map("organization_id")
  
  // Relacionamentos
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("activities")
}
