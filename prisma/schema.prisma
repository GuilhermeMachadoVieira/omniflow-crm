// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------
// CRM SaaS - Multi-tenant Models
// -----------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  customers        Customer[]
  pipelineColumns  PipelineColumn[]
  opportunities    Opportunity[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  nome           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           Role     @default(MEMBER)
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    Customer[]

  @@map("users")
}

model Customer {
  id               String         @id @default(uuid())
  nome             String
  email            String
  telefone         String?
  empresa          String?
  status           CustomerStatus @default(ACTIVE)
  lastPurchaseDate DateTime?      @map("last_purchase_date")
  totalRevenue     Decimal        @default(0) @map("total_revenue") @db.Decimal(12, 2)
  userId           String         @map("user_id")
  organizationId   String         @map("organization_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("customers")
}

model PipelineColumn {
  id             String   @id @default(uuid())
  title          String
  sortOrder      Int      @map("sort_order")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@map("pipeline_columns")
}

model Opportunity {
  id             String   @id @default(uuid())
  title          String
  value          Decimal  @db.Decimal(12, 2)
  priority       Priority @default(MEDIUM)
  columnId       String   @map("column_id")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  column       PipelineColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("opportunities")
}
